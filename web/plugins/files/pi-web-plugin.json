{
  "id": "files",
  "name": "Files",
  "version": "1.0.0",
  "engines": { "piWeb": "^1.0.0", "sdk": "^1.0.0" },
  "main": { "server": "./server/index.ts", "browser": "./dist/browser.js" },
  "trust": "trusted",
  "capabilities": ["routes", "fs.read:*", "ui.slots"],
  "activation": ["onStartup"],
  "contributes": {
    "title": "Files",
    "extension": "web-core.files",
    "icon": "files",
    "description": "Session-scoped file browser, preview, and document viewer.",
    "sessionPanel": true,
    "surfaces": [{ "kind": "sidebar" }]
  }
}
