{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./core/client/*"],
      "@pi-web/host-ui": ["./core/client/host/ui.ts"]
    },
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "app.tsx",
    "server.ts",
    "config/**/*.ts",
    "bench/**/*.ts",
    "core/client/**/*.ts",
    "core/client/**/*.tsx",
    "core/server/**/*.ts",
    "core/shared/**/*.ts",
    "core/adapters/**/*.ts",
    "core/protocol/**/*.ts",
    "plugins/**/*.ts",
    "plugins/**/*.tsx"
  ]
}
