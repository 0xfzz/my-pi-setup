{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./core/client/*"]
    },
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": [
    "core/client/**/*.ts",
    "core/client/**/*.tsx",
    "core/server/**/*.ts",
    "core/shared/**/*.ts",
    "plugins/**/*.ts",
    "plugins/**/*.tsx"
  ]
}
