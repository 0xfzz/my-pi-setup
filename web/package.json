{
  "name": "pi-web-minimal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Minimal realtime pi web client with an extensible, overridable plugin system",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "tsx server/main.ts",
    "dev": "npm run build && npm run start",
    "check": "tsc --noEmit",
    "test": "npm run build && node --experimental-strip-types --test server/*.test.ts client/*.test.ts shared/*.test.ts",
    "test:e2e": "node e2e/e2e.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jiti": "^2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "playwright": "1.63.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4",
    "typescript": "^5.9"
  }
}
