{
  "name": "pi-workflow-extensions",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conditional AI todo enforcement and uncertainty clarification for Pi and Herdr subagents",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "herdr",
    "subagents",
    "orchestrator"
  ],
  "pi": {
    "extensions": [
      "./extensions/todo.ts",
      "./extensions/ask-user.ts",
      "./extensions/agent.ts",
      "./extensions/subagent-checkpoints.ts",
      "./extensions/artifacts.ts",
      "./extensions/smart-timeout.ts",
      "./extensions/modes.ts",
      "./extensions/dynamic-prompt.ts",
      "./extensions/sidebar.ts",
      "./extensions/providers.ts",
      "./extensions/antigravity-accounts.ts",
      "./extensions/account-router.ts",
      "./extensions/bubbly-spinner.ts",
      "./extensions/web-read.ts",
      "./extensions/dashboard.ts",
      "./vendor/antigravity/index.ts",
      "./vendor/antigravity/features/google-search.ts",
      "./vendor/antigravity/features/generate-image.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --import ./tests/isolate-env.mjs --test tests/*.test.ts tests/orchestrator/*.test.ts",
    "test:core": "node --experimental-strip-types --import ./tests/isolate-env.mjs --test tests/*.test.ts",
    "test:orchestrator": "node --experimental-strip-types --import ./tests/isolate-env.mjs --test tests/orchestrator/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "build:wasm": "cargo build --manifest-path crates/ascii-anim-engine/Cargo.toml --target wasm32-unknown-unknown --release && cp crates/ascii-anim-engine/target/wasm32-unknown-unknown/release/ascii_anim_engine.wasm lib/ascii_anim_engine.wasm",
    "lint:smell": "oxlint --deny-warnings extensions lib tests",
    "lint:dead": "knip",
    "lint:dup": "jscpd extensions lib tests --threshold 12 --min-lines 12 --min-tokens 80",
    "smell": "npm run lint:dead && npm run lint:dup",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "jscpd": "^5.4.2",
    "jsdom": "^30.1.3",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.90.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@viz-js/viz": "^3.31.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged --allow-empty"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": "oxlint --deny-warnings"
  }
}
